{
  "name": "iam-distribution-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "prisma generate && next build",
    "start": "next start --port 3002",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "docs:extract": "node scripts/extract-iam-docs.mjs",
    "validate": "npx tsx scripts/run-validation.ts",
    "validate:unit": "npx tsx scripts/run-validation.ts --unit-only",
    "test:phase1-inbound": "npx tsx scripts/run-phase1-inbound-tests.ts",
    "test:phase2-keystroke": "npx tsx scripts/run-phase2-keystroke-adapter-tests.ts",
    "test:phase2-closure": "npx tsx scripts/run-phase2-architecture-closure-tests.ts",
    "test:phase3-lifecycle": "npx tsx scripts/run-phase3-lifecycle-tests.ts",
    "test:phase3-closure": "npx tsx scripts/run-phase3-closure-tests.ts",
    "test:phase4-scoring": "npx tsx scripts/run-phase4-scoring-tests.ts",
    "test:phase5-board": "npx tsx scripts/run-phase5-board-tests.ts",
    "test:phase5a-experience": "npx tsx scripts/run-phase5a-experience-tests.ts",
    "test:unified-ingestion": "npx tsx scripts/run-unified-ingestion-tests.ts",
    "test:classification-segment": "npx tsx scripts/run-classification-segment-tests.ts",
    "test:prescribed-action-plan": "npx tsx scripts/run-prescribed-action-plan-tests.ts",
    "test:revised-scoring": "npx tsx scripts/run-revised-scoring-tests.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "mammoth": "^1.12.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
