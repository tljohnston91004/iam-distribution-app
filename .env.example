DATABASE_URL="file:../data/iam.db"

IAM_DATA_DIR="./data"
IAM_UPLOAD_DIR="./data/uploads"

# Sibling module URLs (defaults for local dev; RSE 3000, IFM 3001, IAM 3002)
RSE_API_URL="http://127.0.0.1:3000"
IFM_API_URL="http://127.0.0.1:3001"

# ---------------------------------------------------------------------------------------------
# DPOS integration (Stage 4A). Everything below is OPTIONAL: when IAM_DEPLOYMENT_MODE is unset or
# STANDALONE_LEGACY, IAM runs exactly as V1.5. No value here is a secret; credentials are supplied
# ONLY through the environment variables named by *_CREDENTIAL_ENV and are never committed.
# ---------------------------------------------------------------------------------------------
# IAM_DEPLOYMENT_MODE="DPOS_INTEGRATED"            # STANDALONE_LEGACY (default) | DPOS_INTEGRATED
# IAM_ENVIRONMENT_CLASS="WORKSHOP"                 # PRODUCTION | WORKSHOP | TEST
# IAM_CONFIGURATION_ID="<configuration identity>"
# IAM_DPOS_COMPANY_ID="<uuid>"                     # must equal IAM_DATA_HUB_COMPANY_ID
# IAM_DATA_HUB_COMPANY_ID="<uuid>"
# IAM_INSTALLATION_ID="<installation identity>"
# IAM_COMPANY_TIME_ZONE="America/Chicago"          # IANA name; missing/invalid => explicit scheduled-refresh failure (never UTC)
# DATA_HUB_BASE_URL="https://<data-hub-origin>"    # origin only
# IAM_RESULTS_RETURN_BASE_URL="https://<data-hub-origin>"   # defaults to DATA_HUB_BASE_URL
# DATA_HUB_HTTP_TIMEOUT_MS="15000"
# IAM_SERVICE_IDENTITY_ID="iam-svc-<uuid>"         # issued with: npm run dpos:admin -- issue-identity --actor <operator>
# IAM_SERVICE_CREDENTIAL_ENV="IAM_DATA_HUB_CREDENTIAL"      # NAME of the env var that holds the credential value
# IAM_FRONT_DOOR_CREDENTIAL_ENV="IAM_FRONT_DOOR_CREDENTIAL" # NAME of the env var that holds the front-door credential
# IAM_REFRESH_HOUR_LOCAL="2"                       # Sunday 02:00 company-local
# IAM_SCHEDULER_ENABLED="true"
# IAM_SCHEDULER_POLL_SECONDS="60"
# IAM_REFRESH_RETRY_MINUTES="30"
# IAM_REFRESH_MAX_ATTEMPTS="4"
# IAM_OUTBOX_RETRY_BASE_SECONDS="30"
# IAM_OUTBOX_RETRY_MAX_SECONDS="3600"
# IAM_OUTBOX_MAX_BATCH="25"
# IAM_OUTBOX_LEASE_SECONDS="120"
# IAM_DPOS_APPLICATION_ROOT="<DPOS application root>"        # holds the module-access runtime
# IAM_DPOS_INSTALLATION_ROOT="<DPOS installation root>"      # holds the installation trust/entitlement state
# IAM_ELIGIBILITY_CACHE_TTL_MS="30000"
# IAM_DPOS_REGISTRY_FILE=""                        # WORKSHOP/TEST only; forbidden in PRODUCTION
