// IAM — Inventory Action Manager (Distribution)
// V1.0 Stage 2 base + V1.5 Phase 1 canonical inbound / Recommendation domain (ADR-IAM-001)
// Enums: src/lib/iam/enums.ts — Review Cycle is physically IamRun until later rename migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id           String   @id @default(uuid()) @map("company_id")
  name         String   @map("company_name")
  businessType String?  @map("business_type")
  posSystem    String?  @map("pos_system")
  active       Boolean  @default(true) @map("active_status")
  /// EEP / Blueprint — Organizational Execution Capability (concurrent active initiatives).
  organizationalExecutionCapability Int @default(2) @map("organizational_execution_capability")
  /// Advisory aging threshold in days (prompts only; never auto-mutates Recommendations).
  recommendationAgingDays Int @default(14) @map("recommendation_aging_days")
  /// Unified ingestion — which evidence channels may submit (standalone always usable when true).
  enableStandaloneUpload Boolean @default(true) @map("enable_standalone_upload")
  enableRseEvidence       Boolean @default(false) @map("enable_rse_evidence")
  enableDataHub           Boolean @default(false) @map("enable_data_hub")
  /// Revised scoring denominators (Decision Priority ratios). Null → calculation exception (no fabricated score).
  trailing52WeekRevenue      Float? @map("trailing_52_week_revenue")
  trailing12MonthGrossProfit Float? @map("trailing_12_month_gross_profit")
  totalInventoryBookValue    Float? @map("total_inventory_book_value")
  /// Annual inventory carrying-cost rate as decimal (e.g. 0.24 = 24%). Per-company config — never invent in UI.
  annualCarryingCostRate     Float? @map("annual_carrying_cost_rate")
  carryingCostRateEffectiveDate DateTime? @map("carrying_cost_rate_effective_date")
  /// Company-provided rate | Calculated company rate | Management-approved assumption | Default onboarding assumption
  carryingCostRateSource     String? @map("carrying_cost_rate_source")
  carryingCostRateNote       String? @map("carrying_cost_rate_note")
  carryingCostRatePermission String? @map("carrying_cost_rate_permission")
  carryingCostRateUpdatedBy  String? @map("carrying_cost_rate_updated_by")
  carryingCostRateUpdatedAt  DateTime? @map("carrying_cost_rate_updated_at")
  /// Absolute max allowed decimal (default 1.0 = 100%).
  carryingCostRateMaxAllowed Float? @map("carrying_cost_rate_max_allowed")
  createdAt    DateTime @default(now()) @map("created_at")

  runs IamRun[]
  configurationChanges CompanyConfigurationChange[]

  @@map("companies")
}

/// Company-level configuration audit (not tied to a single Review Cycle).
model CompanyConfigurationChange {
  id          String   @id @default(uuid()) @map("company_configuration_change_id")
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fieldKey    String   @map("field_key")
  action      String
  performedBy String   @map("performed_by")
  performedAt DateTime @default(now()) @map("performed_at")
  beforeJson  String?  @map("before_json")
  afterJson   String?  @map("after_json")
  detail      String?

  @@index([companyId, fieldKey, performedAt])
  @@map("company_configuration_changes")
}

/// Review Cycle (IAM-007) — table name retained as iam_runs for V1.0 compatibility (Phase 1).
model IamRun {
  id              String   @id @default(uuid()) @map("iam_run_id")
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id])
  runName         String   @map("run_name")
  reviewDate      DateTime @map("review_date")
  reviewWeekStart DateTime @map("review_week_start")
  reviewWeekEnd   DateTime @map("review_week_end")
  reviewCadence   String   @default("weekly") @map("review_cadence")
  runStatus       String   @default("Draft") @map("run_status")
  cycleStatus     String   @default("Open") @map("cycle_status") // Open | Locked | Closed
  /// When set, governed Recommendation transitions are rejected for this Review Cycle (Phase 3).
  cycleLockedAt   DateTime? @map("cycle_locked_at")
  cycleLockedBy   String?  @map("cycle_locked_by")
  readinessStatus String   @default("Not Ready") @map("readiness_status")
  /// Unified ingestion — evidence must be approved before Calculate / analysis.
  /// draft | pending_approval | approved
  evidenceApprovalStatus String @default("draft") @map("evidence_approval_status")
  evidenceApprovedAt     DateTime? @map("evidence_approved_at")
  evidenceApprovedBy     String?  @map("evidence_approved_by")
  runVersion      Int      @default(1) @map("run_version")
  parentRunId     String?  @map("parent_run_id")
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String   @default("pilot-user") @map("created_by")

  sourceDocuments      SourceDocument[]
  inventorySnapshots   InventorySnapshot[]
  demandHistory        DemandHistory[]
  receiptHistory       ReceiptHistorySummary[]
  incomingSupply       IncomingSupply[]
  actionCandidates     ActionCandidate[]
  actions              Action[]
  moduleSignals        ModuleSignal[]
  dataGaps             DataGap[]
  changeLogs           ChangeLog[]
  uploadBatches        UploadBatch[]
  evidenceBatches      EvidenceBatch[]
  evidenceConflicts    EvidenceConflict[]
  recommendations      Recommendation[]
  governanceDecisions  GovernanceDecision[]
  workflowEvents       WorkflowEvent[]
  auditEvents          AuditEvent[]

  @@map("iam_runs")
}

model SourceDocument {
  id                 String   @id @default(uuid()) @map("source_document_id")
  iamRunId           String   @map("iam_run_id")
  run                IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  sourceSystemName   String   @map("source_system_name")
  sourceDocumentName String   @map("source_document_name")
  sourceArea         String?  @map("source_area_or_section")
  sourceReportDate   DateTime? @map("source_report_date")
  freshnessStatus    String   @default("Unknown") @map("freshness_status")
  confidenceLevel    String   @default("Medium Confidence") @map("confidence_level")
  uploadedBy         String?  @map("uploaded_or_entered_by")
  createdAt          DateTime @default(now()) @map("created_at")

  fieldMappings FieldMapping[]

  @@map("source_documents")
}

model FieldMapping {
  id                String         @id @default(uuid()) @map("field_mapping_id")
  sourceDocumentId  String         @map("source_document_id")
  sourceDocument    SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  sourceFieldName   String         @map("source_field_name")
  iamDomain         String         @map("iam_domain")
  iamTable          String         @map("iam_table")
  iamFieldName      String         @map("iam_field_name")
  mappingConfidence String         @default("Medium Confidence") @map("mapping_confidence")
  validationStatus  String         @default("needs review") @map("validation_status")

  @@map("field_mappings")
}

model InventorySnapshot {
  id                 String   @id @default(uuid()) @map("inventory_snapshot_id")
  iamRunId           String   @map("iam_run_id")
  run                IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  skuOrItemId        String   @map("sku_or_item_id")
  description        String?
  quantityOnHand     Float    @map("quantity_on_hand")
  availableQoh       Float?   @map("available_qoh")
  quantityBasisUsed  String?  @map("quantity_basis_used") // available_qoh | on_hand (ADR-IAM-001 / SD-15)
  cost               Float?
  inventoryValue     Float?   @map("inventory_value")
  classification     String?
  itemStatus         String?  @map("item_status")
  vendorName         String?  @map("vendor_name")
  category           String?
  department         String?
  locationCode       String?  @map("location_code")
  productGroup       String?  @map("product_group")
  /// Which channel last supplied classification dimensions (Keystroke / RSE / DataHub / CustomerUpload).
  classificationSource String? @map("classification_source")
  dataConfidence     String   @default("Medium Confidence") @map("data_confidence")
  entityEligibility  String   @default("rankable") @map("entity_eligibility") // rankable | excluded_non_entity
  /// Unified reconciliation — only selected rows feed Calculate.
  selectedForAnalysis Boolean @default(true) @map("selected_for_analysis")
  winningSourceSystem String? @map("winning_source_system")
  evidenceBatchId    String?  @map("evidence_batch_id")
  evidenceBatch      EvidenceBatch? @relation(fields: [evidenceBatchId], references: [id], onDelete: SetNull)
  openOrderQuantity  Float?   @map("open_order_quantity")
  lastSoldDate       DateTime? @map("last_sold_date")
  lastReceivedDate   DateTime? @map("last_received_date")
  sourceRowRef       String?  @map("source_row_ref")

  @@index([iamRunId, skuOrItemId])
  @@index([evidenceBatchId])
  @@map("inventory_snapshots")
}

model DemandHistory {
  id                        String  @id @default(uuid()) @map("demand_history_id")
  iamRunId                  String  @map("iam_run_id")
  run                       IamRun  @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  skuOrItemId               String  @map("sku_or_item_id")
  periodLabel               String  @map("period_label")
  periodCode                String? @map("period_code") // e.g. W13 (ADR Evidence Package)
  unitsSold                 Float   @map("units_sold")
  grossSalesDollars         Float   @map("gross_sales_dollars")
  returnsOrNegativeMovement Float?  @map("returns_or_negative_movement")
  dataConfidence            String  @default("Medium Confidence") @map("data_confidence")
  entityEligibility         String  @default("rankable") @map("entity_eligibility")
  selectedForAnalysis       Boolean @default(true) @map("selected_for_analysis")
  winningSourceSystem       String? @map("winning_source_system")
  evidenceBatchId           String? @map("evidence_batch_id")
  evidenceBatch             EvidenceBatch? @relation(fields: [evidenceBatchId], references: [id], onDelete: SetNull)
  sourceRowRef              String? @map("source_row_ref")

  @@index([iamRunId, skuOrItemId])
  @@index([evidenceBatchId])
  @@map("demand_history")
}

model ReceiptHistorySummary {
  id                   String    @id @default(uuid()) @map("receipt_history_id")
  iamRunId             String    @map("iam_run_id")
  run                  IamRun    @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  skuOrItemId          String    @map("sku_or_item_id")
  firstPurchaseDate    DateTime? @map("first_purchase_date")
  lastReceiptDate      DateTime? @map("last_receipt_date")
  lastReceiptQuantity  Float?    @map("last_receipt_quantity")
  receiptCountLookback Int?      @map("receipt_count_lookback")
  receivedQtyLookback  Float?    @map("received_qty_lookback")

  @@index([iamRunId, skuOrItemId])
  @@map("receipt_history_summary")
}

model IncomingSupply {
  id                  String    @id @default(uuid()) @map("incoming_supply_id")
  iamRunId            String    @map("iam_run_id")
  run                 IamRun    @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  skuOrItemId         String    @map("sku_or_item_id")
  openOrderQuantity   Float?    @map("open_order_quantity")
  expectedReceiptDate DateTime? @map("expected_receipt_date")
  backorderQuantity   Float?    @map("backorder_quantity")
  dataConfidence      String    @default("Medium Confidence") @map("data_confidence")
  evidenceBatchId     String?   @map("evidence_batch_id")
  evidenceBatch       EvidenceBatch? @relation(fields: [evidenceBatchId], references: [id], onDelete: SetNull)

  @@index([iamRunId, skuOrItemId])
  @@map("incoming_supply")
}

/// Canonical Evidence Package batch (ADR-IAM-001 Inbound Port).
model EvidenceBatch {
  id               String   @id @default(uuid()) @map("evidence_batch_id")
  iamRunId         String   @map("iam_run_id")
  run              IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  /// Client/adapter-supplied idempotency key (unique per review cycle).
  externalBatchKey String   @map("external_batch_key")
  sourceSystem     String   @map("source_system")
  sourceReportType String   @map("source_report_type")
  asOfTimestamp    DateTime? @map("as_of_timestamp")
  contentIdentity  String?  @map("content_identity")
  sourceFileName   String?  @map("source_file_name")
  status           String   @default("accepted") @map("status") // accepted | rejected | superseded | pending_reconcile
  itemCount        Int      @default(0) @map("item_count")
  errorDetail      String?  @map("error_detail")
  /// Normalized channel for priority: CustomerUpload | Keystroke | RSE | DataHub | Other
  sourceChannel    String?  @map("source_channel")
  createdAt        DateTime @default(now()) @map("created_at")

  inventorySnapshots InventorySnapshot[]
  demandHistory      DemandHistory[]
  incomingSupply     IncomingSupply[]

  @@unique([iamRunId, externalBatchKey])
  @@index([iamRunId, sourceReportType])
  @@map("evidence_batches")
}

/// Cross-source evidence conflict detected during unified reconciliation.
model EvidenceConflict {
  id               String   @id @default(uuid()) @map("evidence_conflict_id")
  iamRunId         String   @map("iam_run_id")
  run              IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  skuOrItemId      String   @map("sku_or_item_id")
  domain           String   // inventory | demand
  winningSource    String   @map("winning_source")
  losingSource     String   @map("losing_source")
  winningValue     String?  @map("winning_value")
  losingValue      String?  @map("losing_value")
  resolutionRule   String   @map("resolution_rule")
  detailJson       String?  @map("detail_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([iamRunId, skuOrItemId])
  @@map("evidence_conflicts")
}

/// V1.5 Recommendation (primary entity). Legacy Action/ActionCandidate retained for V1 UI until Phase 3–5.
model Recommendation {
  id                       String   @id @default(uuid()) @map("recommendation_id")
  iamRunId                 String   @map("iam_run_id")
  run                      IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  sourceModule             String   @map("source_module")
  sourceRecommendationId   String?  @map("source_recommendation_id")
  generationPath           String   @default("module") @map("generation_path") // module | interim_evidence
  opportunityKey           String   @map("opportunity_key")
  skuOrItemId              String?  @map("sku_or_item_id")
  /// sku | segment — segment Recommendations carry drill-down SKUs in explainabilityJson.
  analysisGrain            String   @default("sku") @map("analysis_grain")
  /// classification | vendor | category | department | location | product_group | portfolio | null
  segmentType              String?  @map("segment_type")
  segmentKey               String?  @map("segment_key")
  affectedSkuCount         Int?     @map("affected_sku_count")
  recommendationType       String   @map("recommendation_type")
  title                    String
  lifecycleState           String   @default("Identified") @map("lifecycle_state") // IAM-007B LS names
  /// Interim SD-13 presentation category (not a lifecycle state).
  presentationCategory     String   @default("managed_backlog") @map("presentation_category")
  // top_2 (legacy alias) | active_priority | waiting_activation | emergency | holdover | deferred | managed_backlog | completed_presentation | archived_history
  presentationRank         Int?     @map("presentation_rank")
  confidence               String   @default("Medium") @map("confidence")
  estimatedFinancialImpact Float?   @map("estimated_financial_impact")
  estimatedCashImpact      Float?   @map("estimated_cash_impact")
  /// Estimated Cost of Inaction (decision-support; not a scoring factor).
  costOfInaction           Float?   @map("cost_of_inaction")
  /// COI structured fields (PO-approved interim formula).
  coiHorizonValue          Float?   @map("coi_horizon_value")
  coiHorizonUnit           String?  @map("coi_horizon_unit") // days | weeks | months
  coiHorizonDays           Int?     @map("coi_horizon_days")
  coiHorizonSource         String?  @map("coi_horizon_source")
  recommendedTargetPeriod  String?  @map("recommended_target_period")
  recommendedTargetEndDate DateTime? @map("recommended_target_end_date")
  managementAdjustedTargetPeriod String? @map("management_adjusted_target_period")
  managementAdjustmentReason     String? @map("management_adjustment_reason")
  managementAdjustedBy           String? @map("management_adjusted_by")
  managementAdjustedAt           DateTime? @map("management_adjusted_at")
  affectedInventoryValueForCoi   Float? @map("affected_inventory_value_for_coi")
  annualCarryingCostRateUsed     Float? @map("annual_carrying_cost_rate_used")
  carryingCostComponent          Float? @map("carrying_cost_component")
  preventableLossComponent       Float? @map("preventable_loss_component")
  otherCoiComponent              Float? @map("other_coi_component")
  coiConfidenceLevel             String? @map("coi_confidence_level")
  coiCalculationStatus           String? @map("coi_calculation_status") // calculated | partial | unavailable
  coiCalculationExplanation      String? @map("coi_calculation_explanation")
  coiBoardDisplayLine            String? @map("coi_board_display_line")
  originalEstimatedCoi           Float? @map("original_estimated_coi")
  revisedEstimatedCoi            Float? @map("revised_estimated_coi")
  coiDetailJson                  String? @map("coi_detail_json")
  /// Phase 4 — authoritative priority from scoring service (interim profile until SD-1).
  priorityScore            Float?   @map("priority_score")
  /// Phase 4 — e.g. interim_v1_cash_led (A-005).
  scoringProfileId         String?  @map("scoring_profile_id")
  /// EEP Trust Pyramid — plain-English presentation (not scoring inputs).
  storyWhat                String?  @map("story_what")
  storyWhy                 String?  @map("story_why")
  storyWhyNow              String?  @map("story_why_now")
  storyExpectedResult      String?  @map("story_expected_result")
  confidenceNarrative      String?  @map("confidence_narrative")
  /// EEP WIP progress (narrative — not lifecycle).
  progressNarrative        String?  @map("progress_narrative")
  blockerNote              String?  @map("blocker_note")
  lastProgressAt           DateTime? @map("last_progress_at")
  expectedCompletionAt     DateTime? @map("expected_completion_at")
  explainabilityJson       String?  @map("explainability_json")
  evidenceRefsJson         String?  @map("evidence_refs_json")
  sourcePayloadHash        String?  @map("source_payload_hash")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  assignments         RecommendationAssignment[]
  contributors        RecommendationContributor[]
  assignmentHistory   RecommendationAssignmentHistory[]
  financialImpacts    FinancialImpact[]
  governanceDecisions GovernanceDecision[]
  workflowEvents      WorkflowEvent[]
  notes               RecommendationNote[]

  @@unique([iamRunId, sourceModule, sourceRecommendationId])
  @@index([iamRunId, opportunityKey])
  @@index([iamRunId, generationPath])
  @@index([iamRunId, presentationCategory])
  @@index([iamRunId, priorityScore])
  @@map("recommendations")
}

model RecommendationAssignment {
  id                 String   @id @default(uuid()) @map("assignment_id")
  recommendationId   String   @map("recommendation_id")
  recommendation     Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  primaryOwnerUserId String   @map("primary_owner_user_id")
  primaryOwnerName   String?  @map("primary_owner_name")
  accepted           Boolean  @default(false)
  progressPercent    Int      @default(0) @map("progress_percent")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([recommendationId, active])
  @@map("recommendation_assignments")
}

model RecommendationContributor {
  id               String   @id @default(uuid()) @map("contributor_id")
  recommendationId String   @map("recommendation_id")
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String   @map("user_id")
  displayName      String?  @map("display_name")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([recommendationId, userId])
  @@map("recommendation_contributors")
}

/// Append-only assignment history (Phase 3 — Contributors / assignment accountability).
model RecommendationAssignmentHistory {
  id                 String   @id @default(uuid()) @map("assignment_history_id")
  recommendationId   String   @map("recommendation_id")
  recommendation     Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  eventType          String   @map("event_type") // assigned | reassigned | accepted | unassigned
  primaryOwnerUserId String?  @map("primary_owner_user_id")
  primaryOwnerName   String?  @map("primary_owner_name")
  performedBy        String   @map("performed_by")
  detailJson         String?  @map("detail_json")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([recommendationId, createdAt])
  @@map("recommendation_assignment_history")
}

/// Phase 5 — contributor / management notes on Recommendations (Board UX).
model RecommendationNote {
  id               String   @id @default(uuid()) @map("note_id")
  recommendationId String   @map("recommendation_id")
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  body             String
  /// shared | management — management hidden from Owner soft viewAs
  visibility       String   @default("shared")
  authoredBy       String   @map("authored_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([recommendationId, createdAt])
  @@map("recommendation_notes")
}

model FinancialImpact {
  id               String   @id @default(uuid()) @map("impact_id")
  recommendationId String   @map("recommendation_id")
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  revision         Int      @default(1)
  expectedValue    Float    @map("expected_value")
  expectedCash     Float?   @map("expected_cash")
  /// Net scoreable 13-week cash for revised Cash Impact ratio (not inventory book value).
  netScoreable13WeekCash Float? @map("net_scoreable_13_week_cash")
  /// Net scoreable profitability improvement/protection for revised Profitability ratio.
  netScoreableProfitability Float? @map("net_scoreable_profitability")
  estimationMethod String?  @map("estimation_method")
  impactPeriod     String?  @map("impact_period")
  actualValue      Float?   @map("actual_value")
  actualCash       Float?   @map("actual_cash")
  currency         String   @default("USD")
  measurable       Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([recommendationId, revision])
  @@map("financial_impacts")
}

/// Governance outcomes (Approve, Reject, Defer, Pause, Escalate, etc.) — not lifecycle states for Defer/Reject.
model GovernanceDecision {
  id               String   @id @default(uuid()) @map("governance_decision_id")
  iamRunId         String   @map("iam_run_id")
  run              IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  recommendationId String?  @map("recommendation_id")
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  decisionType     String   @map("decision_type")
  reason           String?
  performedBy      String   @map("performed_by")
  performedAt      DateTime @default(now()) @map("performed_at")
  detailJson       String?  @map("detail_json")

  @@index([iamRunId, decisionType])
  @@index([recommendationId])
  @@map("governance_decisions")
}

model WorkflowEvent {
  id               String   @id @default(uuid()) @map("workflow_event_id")
  iamRunId         String   @map("iam_run_id")
  run              IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  recommendationId String?  @map("recommendation_id")
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  fromState        String   @map("from_state")
  toState          String   @map("to_state")
  performedBy      String   @map("performed_by")
  eventTime        DateTime @default(now()) @map("event_time")
  reason           String?

  @@index([recommendationId, eventTime])
  @@map("workflow_events")
}

model AuditEvent {
  id          String   @id @default(uuid()) @map("audit_event_id")
  iamRunId    String   @map("iam_run_id")
  run         IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  performedBy String   @map("performed_by")
  performedAt DateTime @default(now()) @map("performed_at")
  detailJson  String?  @map("detail_json")
  requestId   String?  @map("request_id")

  @@index([iamRunId, performedAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model ActionCandidate {
  id                       String   @id @default(uuid()) @map("action_candidate_id")
  iamRunId                 String   @map("iam_run_id")
  run                      IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  skuOrItemId              String?  @map("sku_or_item_id")
  sourceType               String   @map("source_type")
  actionType               String   @map("action_type")
  candidateTitle           String   @map("candidate_title")
  evidenceStrength         String   @map("evidence_strength")
  estimatedCashImpact      Float?   @map("estimated_cash_impact")
  serviceOperationalRisk   Boolean  @default(false) @map("service_operational_risk_flag")
  serviceRiskScore         Float    @default(0) @map("service_risk_score")
  cashImpactScore          Float    @default(0) @map("cash_impact_score")
  priorityScore            Float    @default(0) @map("priority_score")
  priorityCategory         String   @default("new_priority") @map("priority_category")
  readinessLabel           String   @default("Ready with Limitations") @map("readiness_label")
  managementPriorityFlag   Boolean  @default(false) @map("management_priority_flag")
  confidenceLevel          String   @default("Medium Confidence") @map("confidence_level")
  suppressedFlag           Boolean  @default(false) @map("suppressed_flag")
  rankedPosition           Int?     @map("ranked_position")
  detailJson               String?  @map("detail_json")
  createdAt                DateTime @default(now()) @map("created_at")

  actions Action[]

  @@map("action_candidates")
}

model Action {
  id                      String    @id @default(uuid()) @map("action_id")
  iamRunId                String    @map("iam_run_id")
  run                     IamRun    @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  actionCandidateId       String?   @map("action_candidate_id")
  candidate               ActionCandidate? @relation(fields: [actionCandidateId], references: [id], onDelete: SetNull)
  skuOrItemId             String?   @map("sku_or_item_id")
  actionTitle             String    @map("action_title")
  actionType              String    @map("action_type")
  actionStrength          String    @default("Monitor") @map("action_strength")
  priorityScore           Float     @default(0) @map("priority_score")
  priorityCategory        String    @default("new_priority") @map("priority_category")
  workflowState           String    @default("Candidate") @map("workflow_state")
  featuredSlot            Int?      @map("featured_slot")
  ownerRole               String?   @map("owner_role_or_user")
  ownerName               String?   @map("owner_name")
  firstSurfacedDate       DateTime? @map("first_surfaced_date")
  dueDate                 DateTime? @map("due_date")
  reviewDate              DateTime? @map("review_date")
  completedDate           DateTime? @map("completed_date")
  archivedDate            DateTime? @map("archived_date")
  rejectedForCycle        Boolean   @default(false) @map("rejected_for_cycle")
  managementPriorityFlag  Boolean   @default(false) @map("management_priority_flag")
  groupedActionFlag       Boolean   @default(false) @map("grouped_action_flag")
  visibilityClass         String    @default("Management Visible") @map("visibility_class")
  confidenceLevel         String    @default("Medium Confidence") @map("confidence_level")
  originalEstimatedImpact Float?    @map("original_estimated_impact")
  actualAchievedImpact    Float?    @map("actual_achieved_impact")
  detailJson              String?   @map("detail_json")
  createdAt               DateTime  @default(now()) @map("created_at")

  groupedItems GroupedActionItem[]
  notes        ActionNote[]
  archiveCopy  ActionHistoryArchive?

  @@map("actions")
}

model GroupedActionItem {
  id               String  @id @default(uuid()) @map("grouped_action_item_id")
  actionId         String  @map("action_id")
  action           Action  @relation(fields: [actionId], references: [id], onDelete: Cascade)
  childReferenceId String  @map("child_reference_id")
  childStatus      String  @default("open") @map("child_status")
  childNote        String? @map("child_note")

  @@map("grouped_action_items")
}

model ActionNote {
  id              String   @id @default(uuid()) @map("note_id")
  actionId        String   @map("action_id")
  action          Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  noteType        String   @map("note_type")
  visibilityClass String   @map("visibility_class")
  noteText        String   @map("note_text")
  createdBy       String?  @map("created_by")
  createdDate     DateTime @default(now()) @map("created_date")

  @@map("notes")
}

model ActionHistoryArchive {
  id                      String    @id @default(uuid()) @map("archive_record_id")
  actionId                String    @unique @map("action_id")
  action                  Action    @relation(fields: [actionId], references: [id], onDelete: Cascade)
  iamRunId                String    @map("iam_run_id")
  actionTitle             String    @map("action_title")
  actionType              String    @map("action_type")
  ownerRoleOrUser         String?   @map("owner_role_or_user")
  firstSurfacedDate       DateTime  @map("first_surfaced_date")
  completedDate           DateTime? @map("completed_date")
  archivedDate            DateTime  @map("archived_date")
  originalEstimatedImpact Float?    @map("original_estimated_impact")
  actualAchievedImpact    Float?    @map("actual_achieved_impact")

  @@map("action_history_archive")
}

model ModuleSignal {
  id                String   @id @default(uuid()) @map("module_signal_id")
  iamRunId          String   @map("iam_run_id")
  run               IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  sourceModule      String   @map("source_module")
  signalType        String   @map("signal_type")
  signalCategory    String   @default("Advisory") @map("signal_category")
  integrationStatus String   @default("Received") @map("integration_status")
  skuOrItemId       String?  @map("sku_or_item_id")
  summary           String?
  payloadJson       String?  @map("payload_json")
  confidenceLevel   String   @default("Medium Confidence") @map("confidence_level")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([iamRunId, skuOrItemId])
  @@map("module_signals")
}

model DataGap {
  id               String @id @default(uuid()) @map("data_gap_id")
  iamRunId         String @map("iam_run_id")
  run              IamRun @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  affectedArea     String @map("affected_area")
  gapDescription   String @map("gap_description")
  severity         String @default("confidence limiter")
  blockingStatus   String @default("partial") @map("blocking_status")
  status           String @default("open")
  confidenceImpact String @map("confidence_impact")

  @@map("data_gaps")
}

model ChangeLog {
  id         String   @id @default(uuid()) @map("change_log_id")
  iamRunId   String   @map("iam_run_id")
  run        IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  action     String
  detail     String?
  changedBy  String   @default("pilot-user") @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")

  @@map("change_logs")
}

/// Keystroke staging retained; Phase 2 routes through Adapter → Inbound Port.
model UploadBatch {
  id               String   @id @default(uuid()) @map("upload_batch_id")
  iamRunId         String   @map("iam_run_id")
  run              IamRun   @relation(fields: [iamRunId], references: [id], onDelete: Cascade)
  originalFilename String   @map("original_filename")
  fileType         String   @map("file_type")
  demandVariant    String?  @map("demand_variant")
  rowCount         Int      @default(0) @map("row_count")
  status           String   @default("staged") @map("status")
  createdAt        DateTime @default(now()) @map("created_at")

  rows UploadStagingRow[]

  @@index([iamRunId, fileType])
  @@map("upload_batches")
}

model UploadStagingRow {
  id             String  @id @default(uuid()) @map("upload_staging_row_id")
  batchId        String  @map("upload_batch_id")
  batch          UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  skuOrItemId    String  @map("sku_or_item_id")
  description    String?
  /// On-Hand Qty from source (may be null when only Available QOH present).
  quantityOnHand Float?  @map("quantity_on_hand")
  /// Available QOH from source (SD-15 preferred basis when present).
  availableQoh   Float?  @map("available_qoh")
  cost           Float?
  inventoryValue Float?  @map("inventory_value")
  unitsSold      Float?  @map("units_sold")
  salesDollars   Float?  @map("sales_dollars")
  openOrderQty   Float?  @map("open_order_qty")
  /// 1-based spreadsheet row reference (provenance).
  sourceRowRef   String? @map("source_row_ref")
  classification String?
  vendorName     String? @map("vendor_name")
  category       String?
  department     String?
  locationCode   String? @map("location_code")
  productGroup   String? @map("product_group")
  itemStatus     String? @map("item_status")

  @@index([batchId, skuOrItemId])
  @@map("upload_staging_rows")
}

// =====================================================================================================================
// Stage 4A â€” DPOS-integrated IAM core integration foundation (additive only).
//
// Nothing above this line is changed by Stage 4A. These models add NEW tables; they carry no foreign keys to the V1.5
// tables, so the V1.5 data model is preserved byte-for-byte and the Stage 4A migration can be reversed by dropping
// only the tables created here (see prisma/migrations/<stage4a>/down.sql).
//
// Company identity: `dposCompanyId` is the DPOS / Data Hub company UUID. It is stored as supplied by the governed
// company binding and is never defaulted.
// =====================================================================================================================

/// Governed binding of this IAM installation to exactly one DPOS company (company-context foundation).
model DposCompanyBinding {
  id               String   @id @default(uuid()) @map("binding_id")
  /// V1.5 `companies.company_id` this binding uses for legacy-model data (no database FK by design).
  iamCompanyId     String   @unique @map("iam_company_id")
  dposCompanyId    String   @unique @map("dpos_company_id")
  dataHubCompanyId String   @map("data_hub_company_id")
  installationId   String   @map("installation_id")
  /// IANA identifier. NULL when not configured; never defaulted to UTC (the scheduler reports an explicit failure).
  companyTimeZone  String?  @map("company_time_zone")
  /// PRODUCTION | WORKSHOP | TEST
  environmentClass String   @map("environment_class")
  configurationId  String   @map("configuration_id")
  /// ACTIVE | SUSPENDED
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("dpos_company_bindings")
}

/// IAM service identity used for service-to-service calls to Data Hub. Never a human or an end-user role.
/// The credential itself is never stored here: `credentialRef` names the environment variable that holds it.
model DposServiceIdentity {
  id               String    @id @default(uuid()) @map("service_identity_id")
  /// Value sent to Data Hub as the service identity (x-identity-id). Generated, never a person's name.
  identityId       String    @unique @map("identity_id")
  /// Always SERVICE. A USER principal is never recorded here.
  principalKind    String    @default("SERVICE") @map("principal_kind")
  moduleId         String    @default("IAM") @map("module_id")
  dposCompanyId    String    @map("dpos_company_id")
  installationId   String    @map("installation_id")
  environmentClass String    @map("environment_class")
  /// JSON array of capability keys, e.g. datahub.iam_results_return.write
  capabilitiesJson String    @map("capabilities_json")
  /// ACTIVE | REVOKED
  status           String    @default("ACTIVE")
  /// WORKSHOP (secure workshop identity) | PRODUCTION (issued by the DPOS identity platform)
  issuanceKind     String    @map("issuance_kind")
  /// Name of the environment variable holding the bearer credential (optional; never the secret).
  credentialRef    String?   @map("credential_ref")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  issuedBy         String    @map("issued_by")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedBy        String?   @map("revoked_by")
  revokedReason    String?   @map("revoked_reason")

  @@index([dposCompanyId, status])
  @@map("dpos_service_identities")
}

/// Append-only audit trail for the integration foundation (identity issue/revoke/denial, eligibility denials,
/// company-context rejections, refresh and outbox administrative actions).
model DposAuditEvent {
  id            String   @id @default(uuid()) @map("audit_event_id")
  at            DateTime @default(now()) @map("at")
  category      String
  action        String
  outcome       String
  actor         String?
  dposCompanyId String?  @map("dpos_company_id")
  subjectType   String?  @map("subject_type")
  subjectId     String?  @map("subject_id")
  detailJson    String?  @map("detail_json")

  @@index([category, at])
  @@index([subjectType, subjectId])
  @@map("dpos_audit_events")
}

/// One row per refresh attempt (scheduled Sunday refresh or manual Refresh from Data Hub).
model DposRefreshAttempt {
  id                  String    @id @default(uuid()) @map("refresh_attempt_id")
  dposCompanyId       String    @map("dpos_company_id")
  /// SCHEDULED_WEEKLY | MANUAL_REFRESH
  trigger             String
  requestedBy         String    @map("requested_by")
  /// The scheduled occurrence this attempt serves (ISO instant) â€” unique per company for SCHEDULED_WEEKLY so one
  /// occurrence is never run twice. Null for manual refresh.
  scheduledFor        String?   @map("scheduled_for")
  /// True when a missed scheduled occurrence was run late (IAM was not running at the scheduled instant).
  catchUp             Boolean   @default(false) @map("catch_up")
  startedAt           DateTime  @map("started_at")
  completedAt         DateTime? @map("completed_at")
  /// STARTED | SUCCEEDED | FAILED
  status              String
  failureCategory     String?   @map("failure_category")
  failureCode         String?   @map("failure_code")
  failureReason       String?   @map("failure_reason")
  /// Governed data currency reported by Data Hub for this attempt (oldest available source reference time).
  dataCurrentThrough  DateTime? @map("data_current_through")
  operatingPeriodStart String?  @map("operating_period_start")
  operatingPeriodEnd   String?  @map("operating_period_end")
  /// Per-source availability, freshness and source run identity returned by Data Hub (no copied business records).
  inputSummaryJson    String?   @map("input_summary_json")
  hubCorrelationId    String?   @map("hub_correlation_id")

  @@unique([dposCompanyId, trigger, scheduledFor])
  @@index([dposCompanyId, startedAt])
  @@map("dpos_refresh_attempts")
}

/// Single current-refresh-state row per company (what the later Decision Board data-status strip reads).
model DposRefreshState {
  dposCompanyId          String    @id @map("dpos_company_id")
  lastAttemptAt          DateTime? @map("last_attempt_at")
  lastAttemptStatus      String?   @map("last_attempt_status")
  lastSuccessAt          DateTime? @map("last_success_at")
  /// "Last IAM refresh": completion time of the last successful refresh.
  lastIamRefreshAt       DateTime? @map("last_iam_refresh_at")
  dataCurrentThrough     DateTime? @map("data_current_through")
  nextScheduledRefreshAt DateTime? @map("next_scheduled_refresh_at")
  /// OK | MISSING | INVALID | UNAVAILABLE â€” explicit schedule state, never a silent UTC fallback.
  scheduleStatus         String    @default("UNKNOWN") @map("schedule_status")
  scheduleReason         String?   @map("schedule_reason")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("dpos_refresh_state")
}

/// Producer-side outbox for IAM_RESULTS_RETURN_V1. Every outbound event is persisted here BEFORE transmission and is
/// never deleted. The row's payload is what Data Hub receives; retries reuse the same producerEventId and payload.
model DposResultsReturnOutbox {
  id                       String    @id @default(uuid()) @map("outbox_id")
  /// Generated UUID, company-wide unique across all Results Return contracts/producers (Stage 3 rule S3-D6).
  producerEventId          String    @map("producer_event_id")
  dposCompanyId            String    @map("dpos_company_id")
  candidateId              String    @map("candidate_id")
  actionRef                String?   @map("action_ref")
  eventType                String    @map("event_type")
  contractId               String    @map("contract_id")
  contractVersion          String    @map("contract_version")
  /// Optional caller operation key; unique per company so one business operation never creates two events.
  operationKey             String?   @map("operation_key")
  payloadJson              String    @map("payload_json")
  payloadHash              String    @map("payload_hash")
  createdAt                DateTime  @default(now()) @map("created_at")
  attemptCount             Int       @default(0) @map("attempt_count")
  lastAttemptAt            DateTime? @map("last_attempt_at")
  nextAttemptAt            DateTime? @map("next_attempt_at")
  /// PENDING | SYNCED | SYNC_PENDING_RETRY | REJECTED_CORRECTION_REQUIRED | BLOCKED_ADMIN_ACTION
  syncStatus               String    @default("PENDING") @map("sync_status")
  /// TEMPORARY_TECHNICAL | DATA_VALIDATION | CONFIGURATION_SYSTEM
  failureCategory          String?   @map("failure_category")
  failureCode              String?   @map("failure_code")
  failureReason            String?   @map("failure_reason")
  failureIssuesJson        String?   @map("failure_issues_json")
  retryEligible            Boolean   @default(true) @map("retry_eligible")
  manualCorrectionRequired Boolean   @default(false) @map("manual_correction_required")
  adminAlertRaised         Boolean   @default(false) @map("admin_alert_raised")
  acceptedAt               DateTime? @map("accepted_at")
  acknowledgementId        String?   @map("acknowledgement_id")
  acknowledgementJson      String?   @map("acknowledgement_json")
  /// Short transmission lease so two workers never send the same event at once.
  leaseUntil               DateTime? @map("lease_until")

  attempts DposResultsReturnOutboxAttempt[]

  @@unique([dposCompanyId, producerEventId])
  @@unique([dposCompanyId, operationKey])
  @@index([syncStatus, nextAttemptAt])
  @@index([dposCompanyId, candidateId])
  @@map("dpos_results_return_outbox")
}

/// Append-only ledger of every transmission attempt, correction and administrative release for an outbox event.
model DposResultsReturnOutboxAttempt {
  id                String   @id @default(uuid()) @map("attempt_id")
  outboxId          String   @map("outbox_id")
  outbox            DposResultsReturnOutbox @relation(fields: [outboxId], references: [id], onDelete: Restrict)
  attemptNumber     Int      @map("attempt_number")
  /// TRANSMISSION | CORRECTION | ADMIN_RELEASE | LOCAL_VALIDATION
  kind              String
  at                DateTime @default(now()) @map("at")
  httpStatus        Int?     @map("http_status")
  outcome           String
  failureCategory   String?  @map("failure_category")
  failureCode       String?  @map("failure_code")
  acknowledgementJson String? @map("acknowledgement_json")
  durationMs        Int?     @map("duration_ms")
  payloadHash       String?  @map("payload_hash")
  detailJson        String?  @map("detail_json")

  @@index([outboxId, at])
  @@map("dpos_results_return_outbox_attempts")
}

/// Records each governed migration run against this database (backup, legacy-preservation proof).
model DposMigrationRecord {
  id                   String   @id @default(uuid()) @map("migration_record_id")
  migrationName        String   @map("migration_name")
  startedAt            DateTime @map("started_at")
  completedAt          DateTime @map("completed_at")
  outcome              String
  backupFile           String?  @map("backup_file")
  legacyDigestBefore   String?  @map("legacy_digest_before")
  legacyDigestAfter    String?  @map("legacy_digest_after")
  legacyTableCount     Int?     @map("legacy_table_count")
  notes                String?

  @@map("dpos_migration_records")
}

// --------------------------------------------------------------------------------------------------------------------
// Canonical IAM core persistence (structure only in Stage 4A; no scoring, recommendation or closeout logic here)
// --------------------------------------------------------------------------------------------------------------------

/// A) Candidate / priority identity. `candidateId` is the identity sent to Data Hub in subject.candidateId.
model IamCoreCandidate {
  candidateId            String    @id @default(uuid()) @map("candidate_id")
  dposCompanyId          String    @map("dpos_company_id")
  /// Grouped condition identity. At most one OPEN candidate per (company, key); a closed key may recur only as a
  /// NEW candidate linked through recurrenceOfCandidateId.
  groupedConditionKey    String    @map("grouped_condition_key")
  groupedConditionJson   String?   @map("grouped_condition_json")
  /// Data Hub / IAM source run identity that produced this candidate.
  sourceRunId            String?   @map("source_run_id")
  sourceRefreshAttemptId String?   @map("source_refresh_attempt_id")
  sourceEvidenceRefsJson String?   @map("source_evidence_refs_json")
  /// Shared contract vocabulary: CANDIDATE, APPROVED, REJECTED, SUPPRESSED, ESCALATED, RISK_ACCEPTED, ACTIVE,
  /// COMPLETED, OUTCOME_VALIDATED, CLOSED
  lifecycleState         String    @default("CANDIDATE") @map("lifecycle_state")
  recurrenceOfCandidateId String?  @map("recurrence_of_candidate_id")
  originalCreatedAt      DateTime  @map("original_created_at")
  /// Set exactly once at closeout; a closed candidate is never reopened.
  closedAt               DateTime? @map("closed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  recurrenceOf       IamCoreCandidate?  @relation("CandidateRecurrence", fields: [recurrenceOfCandidateId], references: [candidateId], onDelete: Restrict)
  recurrences        IamCoreCandidate[] @relation("CandidateRecurrence")
  recommendations    IamCoreSystemRecommendation[]
  managementPlans    IamCoreManagementPlan[]
  ownerships         IamCoreOwnership[]
  executionState     IamCoreExecutionState?
  outcome            IamCoreOutcome?
  // Stage 4B workflow relations (no columns on this table)
  workflowState      IamCoreWorkflowState?
  workflowHistory    IamCoreWorkflowHistory[]
  managementDecisions IamCoreManagementDecision[]
  suppressions       IamCoreSuppression[]
  evidence           IamCoreCandidateEvidence[]
  assignmentEvents   IamCoreAssignmentEvent[]
  actionTracking     IamCoreActionTracking?
  progressUpdates    IamCoreProgressUpdate[]
  actionStatusHistory IamCoreActionStatusHistory[]
  decisionRequired   IamCoreDecisionRequired[]
  pauseRequests      IamCorePauseRequest[]
  blockers           IamCoreBlocker[]
  // Stage 4C scoring relations (no columns on this table)
  scoringInputs      IamCoreScoringInput[]
  scoreResults       IamCoreScoreResult[]
  displayChanges     IamCoreDisplayChange[]
  priorityGovernance IamCorePriorityGovernance[]
  forcedReviews      IamCoreForcedReview[]
  emergencyReviews   IamCoreEmergencyReview[]
  contributorAuthorizations IamCoreContributorAuthorization[]
  // Stage 4E closeout relations (no columns on this table)
  closeout           IamCoreCloseout?
  recurrenceLinks    IamCoreRecurrenceLink[] @relation("RecurrenceNewCandidate")
  recurrenceLinksAsPrior IamCoreRecurrenceLink[] @relation("RecurrencePriorCandidate")

  @@index([dposCompanyId, lifecycleState])
  @@index([dposCompanyId, groupedConditionKey])
  @@map("iam_core_candidates")
}

/// B) System recommendation. Append-only versions: the original IAM recommendation is never overwritten.
model IamCoreSystemRecommendation {
  recommendationId       String   @id @default(uuid()) @map("recommendation_id")
  candidateId            String   @map("candidate_id")
  candidate              IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  recommendationVersion  Int      @map("recommendation_version")
  recommendedAt          DateTime @map("recommended_at")
  /// Original recommended action direction (descriptive; the recommendation engine is a later stage).
  recommendedActionDirection String @map("recommended_action_direction")
  title                  String?
  summary                String?
  supportingEvidenceRefsJson String? @map("supporting_evidence_refs_json")
  /// Reserved for the later scoring stage (not populated or calculated in Stage 4A).
  domainScore            Float?   @map("domain_score")
  domainRank             Int?     @map("domain_rank")
  recommendationJson     String?  @map("recommendation_json")
  recommendedBy          String   @map("recommended_by")
  createdAt              DateTime @default(now()) @map("created_at")

  managementPlans IamCoreManagementPlan[]

  @@unique([candidateId, recommendationVersion])
  @@map("iam_core_system_recommendations")
}

/// C) Management-approved plan. Stored separately from the system recommendation and never overwrites it.
model IamCoreManagementPlan {
  planId                 String   @id @default(uuid()) @map("plan_id")
  candidateId            String   @map("candidate_id")
  candidate              IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  planVersion            Int      @map("plan_version")
  basedOnRecommendationId String  @map("based_on_recommendation_id")
  basedOnRecommendation  IamCoreSystemRecommendation @relation(fields: [basedOnRecommendationId], references: [recommendationId], onDelete: Restrict)
  /// Shared contract vocabulary: NOT_PLANNED, PROPOSED, APPROVED, REJECTED, SUPERSEDED
  approvalState          String   @default("PROPOSED") @map("approval_state")
  managementDecision     String?  @map("management_decision")
  deviatesFromRecommendation Boolean @default(false) @map("deviates_from_recommendation")
  /// Required (service-enforced) when the plan materially deviates from the system recommendation.
  deviationReason        String?  @map("deviation_reason")
  approver               String?
  approvedAt             DateTime? @map("approved_at")
  planSummary            String?  @map("plan_summary")
  planJson               String?  @map("plan_json")
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([candidateId, planVersion])
  @@map("iam_core_management_plans")
}

/// D) Ownership. A new row per assignment; the previous row is ended, never rewritten.
model IamCoreOwnership {
  ownershipId           String   @id @default(uuid()) @map("ownership_id")
  candidateId           String   @map("candidate_id")
  candidate             IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  responsibleDepartment String   @map("responsible_department")
  taskOwnerId           String?  @map("task_owner_id")
  taskOwnerName         String?  @map("task_owner_name")
  assignedAt            DateTime @map("assigned_at")
  assignedBy            String   @map("assigned_by")
  endedAt               DateTime? @map("ended_at")

  contributors IamCoreContributor[]

  @@index([candidateId, endedAt])
  @@map("iam_core_ownerships")
}

model IamCoreContributor {
  contributorId String   @id @default(uuid()) @map("contributor_id")
  ownershipId   String   @map("ownership_id")
  ownership     IamCoreOwnership @relation(fields: [ownershipId], references: [ownershipId], onDelete: Restrict)
  userId        String   @map("user_id")
  displayName   String?  @map("display_name")
  addedAt       DateTime @default(now()) @map("added_at")

  @@unique([ownershipId, userId])
  @@map("iam_core_contributors")
}

/// E) Execution state structure (values supplied by later stages; nothing is calculated in Stage 4A).
model IamCoreExecutionState {
  candidateId            String   @id @map("candidate_id")
  candidate              IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  /// Shared contract vocabulary: ON_TRACK, ATTENTION, AT_RISK, OVERDUE, PAUSED, BLOCKED, COMPLETED
  actionStatus           String?  @map("action_status")
  actionCompletionPct    Float?   @map("action_completion_pct")
  conditionReductionPct  Float?   @map("condition_reduction_pct")
  remainingExposure      Float?   @map("remaining_exposure")
  remainingExposureUnit  String?  @map("remaining_exposure_unit")
  targetStart            DateTime? @map("target_start")
  targetResolution       DateTime? @map("target_resolution")
  blockersJson           String?  @map("blockers_json")
  updatedBy              String?  @map("updated_by")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("iam_core_execution_states")
}

/// F) Closeout / outcome placeholders (structure only). Once `closeoutAt` is set the row is immutable.
model IamCoreOutcome {
  candidateId            String   @id @map("candidate_id")
  candidate              IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  /// Shared contract vocabulary for final resolution (FULLY_RESOLVED, ...)
  finalResolutionState   String?  @map("final_resolution_state")
  measuredResultJson     String?  @map("measured_result_json")
  /// Attribution fields: measured / natural baseline / IAM-attributed / uncertain-mixed, plus confidence.
  attributionJson        String?  @map("attribution_json")
  attributionConfidence  String?  @map("attribution_confidence")
  residualExposure       Float?   @map("residual_exposure")
  closeoutAt             DateTime? @map("closeout_at")
  lessonsRef             String?  @map("lessons_ref")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("iam_core_outcomes")
}

// =====================================================================================================================
// Stage 4B: governed candidate / management-decision / ownership / active-action WORKFLOW (additive).
//
// New tables only. No V1.5 table and no Stage 4A column is altered; the 4A candidate row keeps its identity and only
// its lifecycleState / closedAt are advanced by the workflow service. Ledgers (history, decisions, assignment events,
// progress updates, status history) are append-only (database triggers). Nothing here scores, ranks, recommends,
// computes a Health Score, or learns: scores/ranks are supplied by a later stage and only carried.
// =====================================================================================================================

/// Workflow position of one candidate (1:1 with iam_core_candidates). Approved path: NEW_CANDIDATE -> PRESENTED ->
/// APPROVED_ASSIGNED -> PENDING_OWNER_ACCEPTANCE -> ACTIVE_ACTION -> COMPLETED_VALIDATED -> COMPLETED_HISTORY, with the
/// management branch states REJECTED / SUPPRESSED / ESCALATED / RISK_ACCEPTED. "Holdover" is deliberately NOT a state.
model IamCoreWorkflowState {
  candidateId          String   @id @map("candidate_id")
  candidate            IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId        String   @map("dpos_company_id")
  workflowState        String   @map("workflow_state")
  /// Denormalised from the candidate so rejection history can be counted per underlying condition.
  groupedConditionKey  String   @map("grouped_condition_key")
  title                String?
  category             String?
  candidateType        String?  @map("candidate_type")
  presentedAt          DateTime? @map("presented_at")
  presentationCount    Int      @default(0) @map("presentation_count")
  /// Forced re-review (suppression expiry, became critical, materially worsened, re-entered, management release).
  reReviewRequired     Boolean  @default(false) @map("re_review_required")
  reReviewReason       String?  @map("re_review_reason")
  reReviewRaisedAt     DateTime? @map("re_review_raised_at")
  /// Qualified rejections of this recurring/continuing condition recorded BEFORE this candidate existed.
  priorQualifiedRejections Int  @default(0) @map("prior_qualified_rejections")
  /// Set when the condition has reached the repeated-rejection threshold (3); senior review is then required.
  repeatedRejectionFlag Boolean @default(false) @map("repeated_rejection_flag")
  seniorReviewRequired Boolean  @default(false) @map("senior_review_required")
  escalatedTo          String?  @map("escalated_to")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([dposCompanyId, workflowState])
  @@index([dposCompanyId, groupedConditionKey])
  @@map("iam_core_workflow_states")
}

/// Append-only ledger of every workflow state change (full history is preserved).
model IamCoreWorkflowHistory {
  historyId     String   @id @default(uuid()) @map("history_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId String   @map("dpos_company_id")
  fromState     String?  @map("from_state")
  toState       String   @map("to_state")
  operation     String
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  reason        String?
  detailJson    String?  @map("detail_json")
  at            DateTime @map("at")

  @@index([candidateId, at])
  @@map("iam_core_workflow_history")
}

/// Append-only management decision ledger. Keeps the ORIGINAL system recommendation reference and the management plan
/// reference separately; the decision never rewrites either.
model IamCoreManagementDecision {
  decisionId             String   @id @default(uuid()) @map("decision_id")
  candidateId            String   @map("candidate_id")
  candidate              IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId          String   @map("dpos_company_id")
  groupedConditionKey    String   @map("grouped_condition_key")
  /// APPROVE, REJECT, SUPPRESS, ESCALATE, RISK_ACCEPT, RETURN_FOR_REVIEW, RELEASE_SUPPRESSION, PAUSE_APPROVED,
  /// PAUSE_DENIED, COMPLETION_VALIDATED, DECISION_RESOLVED
  decisionType           String   @map("decision_type")
  reason                 String?
  actorId                String   @map("actor_id")
  actorRole              String   @map("actor_role")
  decidedAt              DateTime @map("decided_at")
  systemRecommendationId String?  @map("system_recommendation_id")
  recommendationVersion  Int?     @map("recommendation_version")
  planId                 String?  @map("plan_id")
  planVersion            Int?     @map("plan_version")
  /// A rejection of a candidate whose underlying condition still qualified (counts toward repeated-rejection review).
  qualifiedRejection     Boolean  @default(false) @map("qualified_rejection")
  rejectionOrdinal       Int?     @map("rejection_ordinal")
  repeatedRejectionFlagged Boolean @default(false) @map("repeated_rejection_flagged")
  detailJson             String?  @map("detail_json")

  @@index([candidateId, decidedAt])
  @@index([dposCompanyId, groupedConditionKey, decisionType])
  @@map("iam_core_management_decisions")
}

/// Suppression governance. Never erases the candidate, its recommendation, score or history.
model IamCoreSuppression {
  suppressionId String   @id @default(uuid()) @map("suppression_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId String   @map("dpos_company_id")
  reason        String
  actorId       String   @map("actor_id")
  startedAt     DateTime @map("started_at")
  /// Policy maximum (weekly cycles) in force when the suppression was made, and the cycles actually granted.
  maxCycles     Int      @map("max_cycles")
  cycles        Int
  reviewDueAt   DateTime @map("review_due_at")
  /// ACTIVE, RELEASED, EXPIRED
  status        String   @default("ACTIVE")
  endedAt       DateTime? @map("ended_at")
  endedBy       String?  @map("ended_by")
  /// MANAGEMENT_RELEASE, EXPIRED, BECAME_CRITICAL, MATERIALLY_WORSENED, RE_ENTERED
  endTrigger    String?  @map("end_trigger")
  endReason     String?  @map("end_reason")

  @@index([candidateId, status])
  @@map("iam_core_suppressions")
}

/// Drill-down evidence attached to a candidate: REFERENCES only (SKU / vendor / category / PO / backorder identifiers and
/// the Data Hub source run), never the governed dataset itself.
model IamCoreCandidateEvidence {
  evidenceId    String   @id @default(uuid()) @map("evidence_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  evidenceRef   String   @map("evidence_ref")
  /// SKU, VENDOR, CATEGORY, PURCHASE_ORDER, CUSTOMER_BACKORDER, OTHER
  kind          String
  sku           String?
  vendor        String?
  category      String?
  poRef         String?  @map("po_ref")
  backorderRef  String?  @map("backorder_ref")
  sourceRunId   String?  @map("source_run_id")
  detailJson    String?  @map("detail_json")
  attachedAt    DateTime @map("attached_at")
  attachedBy    String   @map("attached_by")

  @@unique([candidateId, evidenceRef])
  @@map("iam_core_candidate_evidence")
}

/// Append-only assignment / reassignment / owner-response history (ownership rows themselves are never rewritten).
model IamCoreAssignmentEvent {
  assignmentEventId String   @id @default(uuid()) @map("assignment_event_id")
  candidateId       String   @map("candidate_id")
  candidate         IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId     String   @map("dpos_company_id")
  /// DEPARTMENT_ASSIGNED, OWNER_ASSIGNED, REASSIGNED, OWNER_ACCEPTED, OWNER_DISCUSSION_REQUESTED, CONTRIBUTORS_CHANGED,
  /// CONTRIBUTOR_AUTHORIZED, CONTRIBUTOR_AUTHORIZATION_REVOKED
  kind              String
  fromDepartment    String?  @map("from_department")
  toDepartment      String?  @map("to_department")
  fromOwnerId       String?  @map("from_owner_id")
  toOwnerId         String?  @map("to_owner_id")
  toOwnerName       String?  @map("to_owner_name")
  reason            String?
  note              String?
  actorId           String   @map("actor_id")
  actorRole         String   @map("actor_role")
  onBehalf          Boolean  @default(false) @map("on_behalf")
  planVersionBefore Int?     @map("plan_version_before")
  planVersionAfter  Int?     @map("plan_version_after")
  at                DateTime @map("at")

  @@index([candidateId, at])
  @@map("iam_core_assignment_events")
}

/// Current active-action tracking (1:1). ACTION COMPLETION and CONDITION REDUCTION are separate columns and are never
/// combined. The contract-vocabulary projection is mirrored into iam_core_execution_states in the same transaction.
model IamCoreActionTracking {
  candidateId            String   @id @map("candidate_id")
  candidate              IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId          String   @map("dpos_company_id")
  /// NOT_STARTED, ON_TRACK, ATTENTION, AT_RISK, OVERDUE, PAUSED, BLOCKED, COMPLETED (NOT_STARTED is IAM-internal).
  actionStatus           String   @default("NOT_STARTED") @map("action_status")
  statusReasonsJson      String?  @map("status_reasons_json")
  statusEvaluatedAt      DateTime? @map("status_evaluated_at")
  targetStart            DateTime? @map("target_start")
  targetResolution       DateTime? @map("target_resolution")
  startedAt              DateTime? @map("started_at")
  completedAt            DateTime? @map("completed_at")
  /// A. action completion (official, owner-controlled).
  actionCompletionPct    Float?   @map("action_completion_pct")
  /// B. condition reduction = (baseline - current) / baseline x 100, only with a valid quantitative baseline. The raw
  /// value is kept (it is negative when the condition worsened); null = NOT YET MEASURED.
  conditionReductionPct  Float?   @map("condition_reduction_pct")
  /// MEASURED or NOT_YET_MEASURED.
  conditionReductionStatus String @default("NOT_YET_MEASURED") @map("condition_reduction_status")
  baselineExposure       Float?   @map("baseline_exposure")
  currentExposure        Float?   @map("current_exposure")
  exposureUnit           String?  @map("exposure_unit")
  /// NOT_YET_MEASURED, IMPROVING, ON_TARGET, FULLY_RESOLVED, SUBSTANTIALLY_RESOLVED, PARTIALLY_RESOLVED,
  /// CONTROLLED_BUT_CONTINUING, UNSUCCESSFUL, NO_LONGER_APPLICABLE (workflow support only; attribution is a later stage).
  resolutionStatus       String   @default("NOT_YET_MEASURED") @map("resolution_status")
  nextMilestone          String?  @map("next_milestone")
  nextMilestoneDue       DateTime? @map("next_milestone_due")
  latestOwnerUpdateAt    DateTime? @map("latest_owner_update_at")
  latestOwnerUpdateBy    String?  @map("latest_owner_update_by")
  latestOwnerUpdateNote  String?  @map("latest_owner_update_note")
  /// Last values sent to the Data Hub (materiality filter: meaningless small changes do not create events).
  lastProgressEventPct   Float?   @map("last_progress_event_pct")
  lastReductionEventPct  Float?   @map("last_reduction_event_pct")
  completionRequestedAt  DateTime? @map("completion_requested_at")
  completionRequestedBy  String?  @map("completion_requested_by")
  completionValidatedAt  DateTime? @map("completion_validated_at")
  completionValidatedBy  String?  @map("completion_validated_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([dposCompanyId, actionStatus])
  @@map("iam_core_action_tracking")
}

/// Append-only ledger of progress / condition-reduction / note / support entries with prior and new values.
model IamCoreProgressUpdate {
  updateId      String   @id @default(uuid()) @map("update_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId String   @map("dpos_company_id")
  /// OFFICIAL_PROGRESS, CONDITION_REDUCTION, BASELINE, MILESTONE, RESOLUTION_STATUS, NOTE, SUPPORTING_WORK, EVIDENCE
  kind          String
  /// Official values can only be written by the primary owner (or an authorized manager / authorized contributor).
  official      Boolean  @default(false)
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  at            DateTime @map("at")
  priorValueJson String? @map("prior_value_json")
  newValueJson  String?  @map("new_value_json")
  note          String?
  evidenceRef   String?  @map("evidence_ref")

  @@index([candidateId, at])
  @@map("iam_core_progress_updates")
}

/// Append-only action-status history (status model transitions, with the reasons and the What-Changed marker).
model IamCoreActionStatusHistory {
  statusHistoryId String   @id @default(uuid()) @map("status_history_id")
  candidateId     String   @map("candidate_id")
  candidate       IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId   String   @map("dpos_company_id")
  fromStatus      String?  @map("from_status")
  toStatus        String   @map("to_status")
  trigger         String
  reasonsJson     String?  @map("reasons_json")
  actorId         String   @map("actor_id")
  at              DateTime @map("at")
  /// AT_RISK / OVERDUE / BLOCKED transitions are marked for the later What Changed Since Last Review section.
  includeInWhatChanged Boolean @default(false) @map("include_in_what_changed")
  decisionRequiredRaised Boolean @default(false) @map("decision_required_raised")

  @@index([candidateId, at])
  @@map("iam_core_action_status_history")
}

/// MANAGEMENT DECISION REQUIRED (active-action intervention). Distinct from a NEW candidate awaiting initial approval,
/// which is workflow state PRESENTED. One OPEN flag per (candidate, reason).
model IamCoreDecisionRequired {
  flagId        String   @id @default(uuid()) @map("flag_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId String   @map("dpos_company_id")
  /// AT_RISK, OVERDUE, BLOCKED, PAUSE_REQUEST, OWNER_DISCUSSION, MATERIAL_DEPENDENCY, MATERIAL_PLAN_DEVIATION,
  /// ESCALATION_REQUEST, COMPLETION_VALIDATION, PAUSE_REVIEW_DUE, CONDITION_WORSENED
  reasonCode    String   @map("reason_code")
  detail        String?
  raisedAt      DateTime @map("raised_at")
  raisedBy      String   @map("raised_by")
  /// OPEN, RESOLVED
  status        String   @default("OPEN")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedBy    String?  @map("resolved_by")
  resolution    String?
  relatedEntityId String? @map("related_entity_id")

  @@index([candidateId, status])
  @@index([dposCompanyId, status])
  @@map("iam_core_decision_required")
}

/// Pause workflow: the owner REQUESTS, management approves or denies. Owners never self-approve a pause.
model IamCorePauseRequest {
  pauseRequestId      String   @id @default(uuid()) @map("pause_request_id")
  candidateId         String   @map("candidate_id")
  candidate           IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId       String   @map("dpos_company_id")
  requestedBy         String   @map("requested_by")
  requestedAt         DateTime @map("requested_at")
  /// The date the pause is requested to start.
  requestedDate       DateTime @map("requested_date")
  reason              String
  expectedDurationDays Int?    @map("expected_duration_days")
  reactivationCondition String? @map("reactivation_condition")
  /// REQUESTED, APPROVED, DENIED, REACTIVATED
  status              String   @default("REQUESTED")
  decidedBy           String?  @map("decided_by")
  decidedAt           DateTime? @map("decided_at")
  decisionReason      String?  @map("decision_reason")
  pausedAt            DateTime? @map("paused_at")
  /// Approved pauses require future review / reactivation.
  reviewDueAt         DateTime? @map("review_due_at")
  reactivatedAt       DateTime? @map("reactivated_at")
  reactivatedBy       String?  @map("reactivated_by")
  reactivationNote    String?  @map("reactivation_note")

  @@index([candidateId, status])
  @@map("iam_core_pause_requests")
}

/// Blocker / dependency record for an active action.
model IamCoreBlocker {
  blockerId     String   @id @default(uuid()) @map("blocker_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId String   @map("dpos_company_id")
  reason        String
  dependency    String?
  material      Boolean  @default(true)
  raisedBy      String   @map("raised_by")
  raisedAt      DateTime @map("raised_at")
  /// OPEN, CLEARED
  status        String   @default("OPEN")
  clearedBy     String?  @map("cleared_by")
  clearedAt     DateTime? @map("cleared_at")
  clearNote     String?  @map("clear_note")

  @@index([candidateId, status])
  @@map("iam_core_blockers")
}

/// Explicit management authorization letting a contributor write OFFICIAL progress values (default: contributors may
/// only add notes, supporting work and evidence).
model IamCoreContributorAuthorization {
  authorizationId String   @id @default(uuid()) @map("authorization_id")
  candidateId     String   @map("candidate_id")
  candidate       IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  userId          String   @map("user_id")
  grantedBy       String   @map("granted_by")
  grantedAt       DateTime @map("granted_at")
  reason          String
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?  @map("revoked_by")

  @@index([candidateId, userId])
  @@map("iam_core_contributor_authorizations")
}
// ======================================================================================================================
// Stage 4C: deterministic IAM scoring, ranking, confidence, modifiers, emergency review and domain-priority governance.
// ADDITIVE ONLY. Nothing here changes a V1.5 table or any Stage 4A / 4B table. The original system recommendation stays
// immutable; scores, ranks and governed priority changes live in these tables and are published through Results Return.
// ======================================================================================================================

/// Immutable, versioned scoring facts for one candidate (what the engine scores). New facts = a new row (inputVersion + 1).
model IamCoreScoringInput {
  inputId        String   @id @default(uuid()) @map("input_id")
  candidateId    String   @map("candidate_id")
  candidate      IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId  String   @map("dpos_company_id")
  inputVersion   Int      @map("input_version")
  /// Validated scoring facts (cash, profitability, inventory, operational risk, customer, time, actionability, confidence, modifiers).
  inputsJson     String   @map("inputs_json")
  inputsHash     String   @map("inputs_hash")
  /// Where the facts came from (Data Hub snapshot / package references, evidence refs).
  sourceRefsJson String?  @map("source_refs_json")
  recordedBy     String   @map("recorded_by")
  recordedAt     DateTime @map("recorded_at")

  @@unique([candidateId, inputVersion])
  @@index([dposCompanyId, candidateId])
  @@map("iam_core_scoring_inputs")
}

/// One governed scoring run. Immutable once written. `runKey` makes a repeated request idempotent.
model IamCoreScoringRun {
  scoringRunId        String   @id @default(uuid()) @map("scoring_run_id")
  dposCompanyId       String   @map("dpos_company_id")
  runKey              String?  @map("run_key")
  runAt               DateTime @map("run_at")
  scoringVersion      String   @map("scoring_version")
  configVersion       String   @map("config_version")
  configHash          String   @map("config_hash")
  /// Full scoring configuration used (thresholds, tables, caps) so any run can be explained and reproduced.
  configJson          String   @map("config_json")
  /// FINALIZED
  status              String
  requestedBy         String   @map("requested_by")
  requestedByRole     String   @map("requested_by_role")
  sourceRefsJson      String?  @map("source_refs_json")
  candidatesConsidered Int     @map("candidates_considered")
  candidatesRanked    Int      @map("candidates_ranked")
  candidatesExcluded  Int      @map("candidates_excluded")
  /// Ordered Top 2 candidate ids (0, 1 or 2 entries; never filled).
  top2Json            String   @map("top2_json")
  /// 4C-D1: the company IANA time zone and the company-local Sunday-Saturday operating week (YYYY-MM-DD of the Sunday) of this run.
  companyTimeZone     String?  @map("company_time_zone")
  operatingWeekStart  String?  @map("operating_week_start")
  summaryJson         String?  @map("summary_json")
  createdAt           DateTime @default(now()) @map("created_at")

  results             IamCoreScoreResult[]

  @@unique([dposCompanyId, runKey])
  @@index([dposCompanyId, runAt])
  @@map("iam_core_scoring_runs")
}

/// One candidate's outcome in one scoring run (ranked with a full breakdown, or excluded with a reason). Immutable.
model IamCoreScoreResult {
  scoreResultId       String   @id @default(uuid()) @map("score_result_id")
  scoringRunId        String   @map("scoring_run_id")
  run                 IamCoreScoringRun @relation(fields: [scoringRunId], references: [scoringRunId], onDelete: Restrict)
  candidateId         String   @map("candidate_id")
  candidate           IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId       String   @map("dpos_company_id")
  groupedConditionKey String   @map("grouped_condition_key")
  /// RANKED, EXCLUDED
  outcome             String
  exclusionReason     String?  @map("exclusion_reason")
  exclusionDetail     String?  @map("exclusion_detail")
  inputId             String?  @map("input_id")
  inputVersion        Int?     @map("input_version")
  workflowState       String?  @map("workflow_state")
  rawCoreScore        Float?   @map("raw_core_score")
  dataConfidence      String?  @map("data_confidence")
  confidenceMultiplier Float?  @map("confidence_multiplier")
  confidenceAdjustedCoreScore Float? @map("confidence_adjusted_core_score")
  uncappedModifierTotal Float? @map("uncapped_modifier_total")
  cappedModifierTotal Float?   @map("capped_modifier_total")
  uncappedDomainScore Float?   @map("uncapped_domain_score")
  /// Final calculated 0..100 domain score (before any governed management override).
  domainScore         Float?   @map("domain_score")
  priorityBand        String?  @map("priority_band")
  /// Calculated (system) rank and the displayed (management) rank. The calculated rank is never overwritten.
  calculatedRank      Int?     @map("calculated_rank")
  displayedRank       Int?     @map("displayed_rank")
  previousCalculatedRank Int?  @map("previous_calculated_rank")
  effectiveScore      Float?   @map("effective_score")
  top2Qualified       Boolean  @default(false) @map("top2_qualified")
  emergencyReviewCandidate Boolean @default(false) @map("emergency_review_candidate")
  criticalOutsideTop2 Boolean  @default(false) @map("critical_outside_top2")
  forcedReviewRequired Boolean @default(false) @map("forced_review_required")
  /// Full explainability: every factor, rationale, modifier, cap, tie-break position and review reason.
  breakdownJson       String?  @map("breakdown_json")
  tieBreakJson        String?  @map("tie_break_json")
  /// 4C-D1: company-local operating week (the Sunday, YYYY-MM-DD) in which this result was produced.
  operatingWeekStart  String?  @map("operating_week_start")
  /// 4C-D4: the mathematical final score before Critical protection, and the governance flags (for example CRITICAL_PROTECTED_FROM_BURDEN_DEMOTION).
  mathematicalDomainScore Float? @map("mathematical_domain_score")
  scoreFlagsJson      String?  @map("score_flags_json")
  /// 4C-D7: SCORED (ranked) / UNSCORED / NOT_RANKABLE with the reason; publishedScoringState is what the Data Hub was last told.
  scoringState        String?  @map("scoring_state")
  scoringStateReason  String?  @map("scoring_state_reason")
  publishedScoringState String? @map("published_scoring_state")
  /// 4C-D5: this result belongs to an additional (second or later) emergency review candidate that needs forced management review.
  additionalEmergencyReviewRequired Boolean @default(false) @map("additional_emergency_review_required")
  /// CANDIDATE_SCORED / SCORING_STATE_CHANGED / DOMAIN_PRIORITY_CHANGED when this result was published, else null.
  publishedEventType  String?  @map("published_event_type")
  publishedOutboxId   String?  @map("published_outbox_id")
  scoredAt            DateTime @map("scored_at")

  @@unique([scoringRunId, candidateId])
  @@index([candidateId, scoredAt])
  @@index([dposCompanyId, scoredAt])
  @@map("iam_core_score_results")
}

/// Append-only governance ledger: overrides, rank locks, manual tie-breaks, strategic authorization, emergency decisions,
/// data investigations and forced-review actions. Every row records a stable DPOS user id (4C-D5), a role and a reason.
model IamCorePriorityGovernance {
  governanceId  String   @id @default(uuid()) @map("governance_id")
  batchId       String?  @map("batch_id")
  dposCompanyId String   @map("dpos_company_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  /// PRIORITY_OVERRIDE, OVERRIDE_REVOKED, RANK_LOCK, RANK_UNLOCK, MANUAL_TIEBREAK, STRATEGIC_AUTHORIZED, STRATEGIC_REVOKED,
  /// EMERGENCY_CONFIRMED, EMERGENCY_DECLINED, EMERGENCY_CLEARED, DATA_INVESTIGATION_ROUTED, FORCED_REVIEW_RESOLVED
  actionType    String   @map("action_type")
  actorId       String   @map("actor_id")
  actorRole     String   @map("actor_role")
  reason        String
  /// Override points (signed) for PRIORITY_OVERRIDE; the strategic level / locked rank / tie-break position live in detail.
  points        Float?
  /// MINOR, MATERIAL (overrides)
  magnitudeClass String? @map("magnitude_class")
  detailJson    String?  @map("detail_json")
  effectiveAt   DateTime @map("effective_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([candidateId, actionType, effectiveAt])
  @@index([dposCompanyId, actionType])
  @@map("iam_core_priority_governance")
}

/// Management review forced by the scoring rules (critical outside Top 2, repeated rejection, insufficient data, ...).
model IamCoreForcedReview {
  reviewId      String   @id @default(uuid()) @map("review_id")
  dposCompanyId String   @map("dpos_company_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  /// CRITICAL_OUTSIDE_TOP2, REPEATED_REJECTION, ADDITIONAL_EMERGENCY, SUPPRESSION_RE_REVIEW, DATA_INVESTIGATION, POSSIBLE_DOUBLE_COUNTING
  reasonCode    String   @map("reason_code")
  /// OPEN, RESOLVED
  status        String   @default("OPEN")
  detail        String?
  raisedAt      DateTime @map("raised_at")
  raisedByRunId String?  @map("raised_by_run_id")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedBy    String?  @map("resolved_by")
  resolutionBasis String? @map("resolution_basis")
  resolution    String?

  @@index([dposCompanyId, status])
  @@index([candidateId, reasonCode, status])
  @@map("iam_core_forced_reviews")
}

/// An emergency review candidate raised by the triggers A-E. A candidate is NOT an emergency until management confirms it.
model IamCoreEmergencyReview {
  emergencyReviewId String @id @default(uuid()) @map("emergency_review_id")
  dposCompanyId String   @map("dpos_company_id")
  candidateId   String   @map("candidate_id")
  candidate     IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  /// CANDIDATE, CONFIRMED, DECLINED, WITHDRAWN, CLEARED
  status        String   @default("CANDIDATE")
  triggersJson  String   @map("triggers_json")
  raisedRunId   String?  @map("raised_run_id")
  raisedAt      DateTime @map("raised_at")
  /// True when another emergency was already confirmed for the company (the extra one needs a forced review).
  additionalEmergency Boolean @default(false) @map("additional_emergency")
  decidedBy     String?  @map("decided_by")
  decidedAt     DateTime? @map("decided_at")
  decisionReason String? @map("decision_reason")

  @@index([dposCompanyId, status])
  @@index([candidateId, status])
  @@map("iam_core_emergency_reviews")
}

/// 4C-D8: immediate governance changes (rank lock, manual tie-break, management promote/demote of displayed priority). Each row is the
/// displayed-priority state published right after the governed change, WITHOUT a new calculation: the calculated score and rank in
/// iam_core_score_results are never rewritten. Append-only; the next scoring run compares against the newest of this table and the results.
model IamCoreDisplayChange {
  displayChangeId     String   @id @default(uuid()) @map("display_change_id")
  dposCompanyId       String   @map("dpos_company_id")
  candidateId         String   @map("candidate_id")
  candidate           IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  /// The governance ledger row that caused the change.
  governanceId        String   @map("governance_id")
  /// The score result whose calculated values were reused (the calculation itself is untouched).
  basedOnScoreResultId String  @map("based_on_score_result_id")
  /// Displayed rank / Top 2 / override / rank lock after the change (PublishedState).
  stateJson           String   @map("state_json")
  publishedEventType  String?  @map("published_event_type")
  publishedOutboxId   String?  @map("published_outbox_id")
  createdAt           DateTime @map("created_at")

  @@index([candidateId, createdAt])
  @@index([dposCompanyId, createdAt])
  @@map("iam_core_display_changes")
}

// =====================================================================================================================
// Stage 4D: Inventory Management Health Score, board review marks (additive).
//
// New tables only. Governed health EVIDENCE is versioned and append-only; every Health Score is an immutable history row that
// stores its calculation version, its curve status (PROVISIONAL until the Product Owner approves the curves), every component
// value, availability and effective weight, and the source references it used. Nothing here scores candidates, changes a
// Stage 4C result, or recreates RSE logic.
// =====================================================================================================================

/// Governed health evidence for one component (the authoritative RSE / Data Hub values IAM consumes; never recomputed here).
model IamCoreHealthEvidence {
  evidenceId      String   @id @default(uuid()) @map("evidence_id")
  dposCompanyId   String   @map("dpos_company_id")
  /// POSITION_BALANCE, EFFICIENCY, SLOW_NONMOVING, COMPANY_FACTS
  kind            String
  evidenceVersion Int      @map("evidence_version")
  evidenceJson    String   @map("evidence_json")
  evidenceHash    String   @map("evidence_hash")
  /// Governed source references (RSE run / Data Hub batch ids). Required: evidence without a source is refused.
  sourceRefsJson  String   @map("source_refs_json")
  /// The "data current through" instant of the evidence.
  asOf            DateTime? @map("as_of")
  recordedBy      String   @map("recorded_by")
  recordedByRole  String   @map("recorded_by_role")
  recordedAt      DateTime @map("recorded_at")

  @@unique([dposCompanyId, kind, evidenceVersion])
  @@index([dposCompanyId, kind, recordedAt])
  @@map("iam_core_health_evidence")
}

/// One immutable Health Score calculation (history is never rewritten; a future formula version never reinterprets old rows).
model IamCoreHealthScore {
  healthScoreId      String   @id @default(uuid()) @map("health_score_id")
  dposCompanyId      String   @map("dpos_company_id")
  /// IAM_HEALTH_SCORE_V1 ...
  healthVersion      String   @map("health_version")
  /// PROVISIONAL (curves pending Product Owner approval) or APPROVED.
  curveStatus        String   @map("curve_status")
  configHash         String   @map("config_hash")
  /// Idempotency key: repeating the same calculation request returns the stored row.
  calcKey            String?  @map("calc_key")
  /// Company-local Sunday-Saturday review cycle (the Sunday, YYYY-MM-DD) in which this was calculated.
  operatingWeekStart String   @map("operating_week_start")
  companyTimeZone    String?  @map("company_time_zone")
  calculatedAt       DateTime @map("calculated_at")
  /// CALCULATED, or NO_COMPONENT_AVAILABLE (no score, no label: nothing is invented and nothing is scored as zero).
  status             String
  /// Composite 0..100 rounded half-up to two decimals; null when no component was available.
  score              Float?
  /// STRONG, HEALTHY, WATCH, NEEDS_ATTENTION (null with no score).
  label              String?
  availableComponents Int     @map("available_components")
  /// Every component: value, availability, unavailable reason, nominal weight, effective (renormalized) weight, key drivers, evidence refs.
  componentsJson     String   @map("components_json")
  /// The source / run / evidence references the calculation used.
  sourceRefsJson     String   @map("source_refs_json")
  dataCurrentThrough DateTime? @map("data_current_through")
  requestedBy        String   @map("requested_by")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([dposCompanyId, calcKey])
  @@index([dposCompanyId, calculatedAt])
  @@index([dposCompanyId, operatingWeekStart])
  @@map("iam_core_health_scores")
}

/// "Mark board reviewed": the boundary of "What Changed Since Last Review". Append-only.
model IamCoreBoardReview {
  reviewId           String   @id @default(uuid()) @map("review_id")
  dposCompanyId      String   @map("dpos_company_id")
  reviewedAt         DateTime @map("reviewed_at")
  reviewedBy         String   @map("reviewed_by")
  reviewedByRole     String   @map("reviewed_by_role")
  operatingWeekStart String   @map("operating_week_start")
  healthScoreId      String?  @map("health_score_id")
  note               String?
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([dposCompanyId, reviewedAt])
  @@map("iam_core_board_reviews")
}


// =====================================================================================================================
// Stage 4E: formal closeout, outcome attribution, recurrence and learning (additive; no earlier table is altered).
// =====================================================================================================================

/// The closeout case of one execution-complete candidate (exactly one per candidate). The case header moves STARTED -> MEASURED ->
/// APPROVED -> CLOSED; CLOSED is final (a database trigger refuses any later change). Every measurement / assessment is an immutable
/// version in IamCoreCloseoutVersion; every approval, learning record and history entry is append-only.
model IamCoreCloseout {
  closeoutId            String   @id @default(uuid()) @map("closeout_id")
  candidateId           String   @unique @map("candidate_id")
  candidate             IamCoreCandidate @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  dposCompanyId         String   @map("dpos_company_id")
  groupedConditionKey   String   @map("grouped_condition_key")
  /// STARTED, MEASURED, APPROVED, CLOSED
  status                String   @default("STARTED")
  /// Latest closeout version (0 until the first measurement / assessment is recorded).
  currentVersion        Int      @default(0) @map("current_version")
  /// The version management approved; cleared when a newer version is recorded before the lock.
  approvedVersion       Int?     @map("approved_version")
  planVersion           Int?     @map("plan_version")
  recommendationVersion Int?     @map("recommendation_version")
  startedAt             DateTime @map("started_at")
  startedBy             String   @map("started_by")
  startedByRole         String   @map("started_by_role")
  approvedAt            DateTime? @map("approved_at")
  approvedBy            String?  @map("approved_by")
  /// The permanent lock. Set exactly once with CLOSED.
  closedAt              DateTime? @map("closed_at")
  closedBy              String?  @map("closed_by")
  finalResolutionStatus String?  @map("final_resolution_status")
  finalAttributionCategory String? @map("final_attribution_category")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  versions  IamCoreCloseoutVersion[]
  approvals IamCoreCloseoutApproval[]
  history   IamCoreCloseoutHistory[]
  learning  IamCoreLearningRecord[]

  @@index([dposCompanyId, status])
  @@map("iam_core_closeouts")
}

/// One immutable measurement / assessment of a closeout. A revision is a NEW row; a prior version is never edited.
model IamCoreCloseoutVersion {
  versionId             String   @id @default(uuid()) @map("version_id")
  closeoutId            String   @map("closeout_id")
  closeout              IamCoreCloseout @relation(fields: [closeoutId], references: [closeoutId], onDelete: Restrict)
  candidateId           String   @map("candidate_id")
  dposCompanyId         String   @map("dpos_company_id")
  closeoutVersion       Int      @map("closeout_version")
  supersedesVersion     Int?     @map("supersedes_version")
  /// MEASUREMENT (a value was measured) or NOT_YET_MEASURED (no adequate evidence yet: next date, reason and required evidence recorded).
  assessmentKind        String   @map("assessment_kind")
  recordedAt            DateTime @map("recorded_at")
  recordedBy            String   @map("recorded_by")
  recordedByRole        String   @map("recorded_by_role")
  // ---- execution + measurement window
  actionCompletedAt     DateTime? @map("action_completed_at")
  actionCompletionPct   Float?   @map("action_completion_pct")
  measurementStart      DateTime? @map("measurement_start")
  measurementEnd        DateTime? @map("measurement_end")
  evidenceCurrentThrough DateTime? @map("evidence_current_through")
  nextMeasurementDate   DateTime? @map("next_measurement_date")
  notYetMeasuredReason  String?  @map("not_yet_measured_reason")
  requiredEvidenceJson  String?  @map("required_evidence_json")
  // ---- measurement (units preserved; never summed across units)
  baselineExposure      Float?   @map("baseline_exposure")
  finalExposure         Float?   @map("final_exposure")
  exposureUnit          String?  @map("exposure_unit")
  /// (baseline - final) / baseline x 100, unclamped; null with NOT_MEASURABLE when the baseline is zero / missing or the final value is missing.
  conditionReductionPct Float?   @map("condition_reduction_pct")
  /// MEASURED or NOT_MEASURABLE
  conditionReductionState String @map("condition_reduction_state")
  residualJson          String?  @map("residual_json")
  expectedVsActualJson  String?  @map("expected_vs_actual_json")
  businessImpactJson    String?  @map("business_impact_json")
  // ---- resolution: the system's definitional guidance and what this version asserts
  recommendedStatus     String?  @map("recommended_status")
  judgementRequired     Boolean  @default(false) @map("judgement_required")
  recommendationBasisJson String @map("recommendation_basis_json")
  /// One of the nine resolution statuses.
  assessedStatus        String   @map("assessed_status")
  assessmentOverrideReason String? @map("assessment_override_reason")
  // ---- confidence + attribution (attribution is separate from the outcome)
  /// HIGH, MEDIUM, LOW, INSUFFICIENT
  outcomeConfidence     String   @map("outcome_confidence")
  outcomeConfidenceRationale String? @map("outcome_confidence_rationale")
  attributionCategory   String   @map("attribution_category")
  attributionRationale  String   @map("attribution_rationale")
  /// HIGH, MODERATE, LOW, NOT_MEASURABLE
  attributionConfidence String   @map("attribution_confidence")
  attributionEvidenceJson String? @map("attribution_evidence_json")
  alternativesJson      String?  @map("alternatives_json")
  recurrenceRisk        String   @default("UNKNOWN") @map("recurrence_risk")
  recurrenceRiskRationale String? @map("recurrence_risk_rationale")
  followUpRecommendation String? @map("follow_up_recommendation")
  dataLimitationsJson   String?  @map("data_limitations_json")
  evidenceRefsJson      String?  @map("evidence_refs_json")
  observationRefsJson   String?  @map("observation_refs_json")
  // ---- contexts captured read-only at the time of the version (scoring / Health are never recomputed or mutated)
  scoringContextJson    String?  @map("scoring_context_json")
  healthContextJson     String?  @map("health_context_json")
  planContextJson       String?  @map("plan_context_json")
  coiJson               String?  @map("coi_json")
  contentHash           String   @map("content_hash")

  approval IamCoreCloseoutApproval?

  @@unique([closeoutId, closeoutVersion])
  @@index([candidateId, closeoutVersion])
  @@map("iam_core_closeout_versions")
}

/// Management approval of ONE closeout version: the system recommendation and the approved final status are both preserved.
model IamCoreCloseoutApproval {
  approvalId            String   @id @default(uuid()) @map("approval_id")
  closeoutId            String   @map("closeout_id")
  closeout              IamCoreCloseout @relation(fields: [closeoutId], references: [closeoutId], onDelete: Restrict)
  candidateId           String   @map("candidate_id")
  dposCompanyId         String   @map("dpos_company_id")
  closeoutVersion       Int      @map("closeout_version")
  version               IamCoreCloseoutVersion @relation(fields: [closeoutId, closeoutVersion], references: [closeoutId, closeoutVersion], onDelete: Restrict)
  recommendedStatus     String?  @map("recommended_status")
  assessedStatus        String   @map("assessed_status")
  /// One of the six final statuses (never NOT_YET_MEASURED / IMPROVING / ON_TARGET).
  finalStatus           String   @map("final_status")
  /// Required when finalStatus differs from the system recommendation (or no recommendation existed).
  overrideReason        String?  @map("override_reason")
  approvedBy            String   @map("approved_by")
  approvedByRole        String   @map("approved_by_role")
  approvedAt            DateTime @map("approved_at")
  note                  String?
  learningNotApplicableReason String? @map("learning_not_applicable_reason")

  @@unique([closeoutId, closeoutVersion])
  @@map("iam_core_closeout_approvals")
}

/// Append-only closeout timeline (started, owner observation, measurement, approval, learning, completion).
model IamCoreCloseoutHistory {
  historyId             String   @id @default(uuid()) @map("history_id")
  closeoutId            String   @map("closeout_id")
  closeout              IamCoreCloseout @relation(fields: [closeoutId], references: [closeoutId], onDelete: Restrict)
  candidateId           String   @map("candidate_id")
  dposCompanyId         String   @map("dpos_company_id")
  operation             String
  fromStatus            String?  @map("from_status")
  toStatus              String?  @map("to_status")
  closeoutVersion       Int?     @map("closeout_version")
  actorId               String   @map("actor_id")
  actorRole             String   @map("actor_role")
  reason                String?
  detailJson            String?  @map("detail_json")
  at                    DateTime

  @@index([closeoutId, at])
  @@index([candidateId, at])
  @@map("iam_core_closeout_history")
}

/// A descriptive learning record: EVIDENCE ONLY. Nothing here changes scoring weights, Health curves, RSE policy or recommendations.
model IamCoreLearningRecord {
  learningId            String   @id @default(uuid()) @map("learning_id")
  closeoutId            String   @map("closeout_id")
  closeout              IamCoreCloseout @relation(fields: [closeoutId], references: [closeoutId], onDelete: Restrict)
  closeoutVersion       Int      @map("closeout_version")
  candidateId           String   @map("candidate_id")
  dposCompanyId         String   @map("dpos_company_id")
  groupedConditionKey   String   @map("grouped_condition_key")
  actionType            String?  @map("action_type")
  department            String?
  ownerRole             String?  @map("owner_role")
  /// Candidate-specific condition DETAIL (free text). Never an analytical grouping key.
  conditionType         String?  @map("condition_type")
  /// Governed condition family code (stable) and the vocabulary version it was written under. The analytical grouping key.
  conditionFamily       String?  @map("condition_family")
  conditionFamilyVersion String? @map("condition_family_version")
  /// PRODUCER, MANAGEMENT or DEFAULT_UNCLASSIFIED
  conditionFamilySource String?  @map("condition_family_source")
  category              String?
  recommendationText    String?  @map("recommendation_text")
  planSummary           String?  @map("plan_summary")
  /// FOLLOWED, MODIFIED, SELECTED_ALTERNATIVE, REJECTED_THEN_APPROVED, DELAYED, SUPPRESSED_THEN_APPROVED
  managementResponse    String   @map("management_response")
  deviationReason       String?  @map("deviation_reason")
  managementPathJson    String?  @map("management_path_json")
  executionResultJson   String   @map("execution_result_json")
  conditionResultJson   String   @map("condition_result_json")
  assessedStatus        String   @map("assessed_status")
  attributionCategory   String   @map("attribution_category")
  outcomeConfidence     String   @map("outcome_confidence")
  expectedVsActualJson  String?  @map("expected_vs_actual_json")
  timeToResultDays      Float?   @map("time_to_result_days")
  recurrenceSequence    Int      @default(1) @map("recurrence_sequence")
  recurrenceJson        String?  @map("recurrence_json")
  whatWorked            String?  @map("what_worked")
  whatDidNotWork        String?  @map("what_did_not_work")
  barriersJson          String?  @map("barriers_json")
  assumptionsJson       String?  @map("assumptions_json")
  dependenciesJson      String?  @map("dependencies_json")
  futureHandling        String?  @map("future_handling")
  dataLimitationsJson   String?  @map("data_limitations_json")
  evidenceRefsJson      String?  @map("evidence_refs_json")
  recordedBy            String   @map("recorded_by")
  recordedByRole        String   @map("recorded_by_role")
  recordedAt            DateTime @map("recorded_at")

  @@unique([closeoutId, closeoutVersion])
  @@index([dposCompanyId, recordedAt])
  @@map("iam_core_learning_records")
}

/// The immutable governed condition-family classification of a candidate (one per candidate; code + vocabulary version).
model IamCoreConditionClassification {
  candidateId       String   @id @map("candidate_id")
  dposCompanyId     String   @map("dpos_company_id")
  familyCode        String   @map("family_code")
  vocabularyVersion String   @map("vocabulary_version")
  /// PRODUCER or MANAGEMENT
  source            String
  classifiedBy      String   @map("classified_by")
  classifiedAt      DateTime @map("classified_at")
  detailJson        String?  @map("detail_json")

  @@index([dposCompanyId, familyCode])
  @@map("iam_core_condition_classifications")
}

/// Recurrence metadata: a returning condition is a NEW candidate linked to the prior CLOSED one (never a reopen). Append-only; a
/// review of an uncertain match is a later row that supersedes the REQUIRES_REVIEW row.
model IamCoreRecurrenceLink {
  recurrenceId          String   @id @default(uuid()) @map("recurrence_id")
  dposCompanyId         String   @map("dpos_company_id")
  candidateId           String   @map("candidate_id")
  candidate             IamCoreCandidate @relation("RecurrenceNewCandidate", fields: [candidateId], references: [candidateId], onDelete: Restrict)
  priorCandidateId      String   @map("prior_candidate_id")
  priorCandidate        IamCoreCandidate @relation("RecurrencePriorCandidate", fields: [priorCandidateId], references: [candidateId], onDelete: Restrict)
  groupedConditionKey   String   @map("grouped_condition_key")
  /// Position in the chain (the original condition is 1, its first recurrence 2) and the recurrence count (first recurrence 1).
  recurrenceSequence    Int      @map("recurrence_sequence")
  recurrenceCount       Int      @map("recurrence_count")
  /// LINKED (exact grouped-condition match), REQUIRES_REVIEW (uncertain), REVIEW_CONFIRMED, REVIEW_DECLINED
  matchStatus           String   @map("match_status")
  /// EXACT_GROUPED_KEY, FACET_OVERLAP, EVIDENCE_OVERLAP
  matchBasis            String   @map("match_basis")
  matchDetailJson       String?  @map("match_detail_json")
  priorResolutionStatus String?  @map("prior_resolution_status")
  priorCloseoutAt       DateTime? @map("prior_closeout_at")
  priorPlanSummary      String?  @map("prior_plan_summary")
  priorActionSummary    String?  @map("prior_action_summary")
  supersedesRecurrenceId String? @map("supersedes_recurrence_id")
  decidedBy             String?  @map("decided_by")
  decidedByRole         String?  @map("decided_by_role")
  decisionReason        String?  @map("decision_reason")
  createdAt             DateTime @map("created_at")

  @@index([dposCompanyId, matchStatus])
  @@index([candidateId])
  @@index([priorCandidateId])
  @@map("iam_core_recurrence_links")
}
